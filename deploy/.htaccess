# GENERATED by scripts/gen-deploy.mjs from scripts/security-headers.mjs — do not edit by hand; regenerate instead.

# Apache config for a public I Ching host. Place alongside dist/index.html
# (with AllowOverride enabled) or inline into the <VirtualHost>.

<IfModule mod_headers.c>
  # The app is a single self-contained document: apply to every response.
  Header always set Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'none'; font-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; navigate-to 'none'; frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(), bluetooth=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), paste=(), payment=(), picture-in-picture=(), serial=(), speaker-selection=(), storage-access=(), sync-xhr=(), usb=(), vr=(), wake-lock=(), web-share=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # HSTS only on HTTPS responses (env set by the rewrite below).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set Cache-Control "public, max-age=86400, stale-while-revalidate=604800, must-revalidate"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # B-16: plain HTTP must 308-redirect to HTTPS; nothing is ever served plaintext.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]
</IfModule>

# No directory listings, no server tokens leaking implementation details.
Options -Indexes
ServerSignature Off

# NOTE: the app sets no cookies. If a session layer is ever added, cookies must
# carry Secure + HttpOnly + SameSite=Lax (enforce at the proxy if possible).
