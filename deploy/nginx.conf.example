# GENERATED by scripts/gen-deploy.mjs from scripts/security-headers.mjs — do not edit by hand; regenerate instead.

# nginx config for a public I Ching host (nginx ≥ 1.19).
# Set server_name and the two certificate paths, then include this in http{}.

# B-16: plain HTTP is a 308 redirect to HTTPS — nothing is ever served plaintext.
server {
    listen 80;
    listen [::]:80;
    server_name iching.example.org;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl http2;
    server_name iching.example.org;

    ssl_certificate     /etc/letsencrypt/live/iching.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/iching.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:1m;
    ssl_session_timeout 1d;

    root /var/www/iching;                       # contains only index.html
    index index.html;

    # B-15: full lockdown header set (generated from the canonical spec).
    add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'none'; font-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; navigate-to 'none'; frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(), bluetooth=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), paste=(), payment=(), picture-in-picture=(), serial=(), speaker-selection=(), storage-access=(), sync-xhr=(), usb=(), vr=(), wake-lock=(), web-share=(), xr-spatial-tracking=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800, must-revalidate" always;

    # NOTE: the app sets no cookies. If a session layer is ever added, cookies
    # must carry Secure + HttpOnly + SameSite=Lax.

    # Serve only the artifact; everything else 404s (no path traversal targets,
    # no server-side execution surface of any kind).
    location / {
        try_files $uri /index.html =404;
    }
    location ~ /. { deny all; }

    server_tokens off;
}
